# Copy to .env.<your-project-id> and fill in. Secrets (bot token, SMTP password)
# are NOT stored here: set them with `firebase functions:secrets:set`.
APP_URL=https://your-firebase-project-id.web.app
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
MAIL_FROM=Drawdown Monitor <alerts@example.com>
