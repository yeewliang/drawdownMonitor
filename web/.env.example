# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FUNCTIONS_REGION=asia-southeast1

# Telegram bot username (without @) used for the "Connect Telegram" deep link
VITE_TELEGRAM_BOT_USERNAME=YourDrawdownBot

# Set to "true" to use the local Firebase emulators
VITE_USE_EMULATORS=false

# Optional: override the MCP endpoint URL shown in Settings (e.g. a custom domain)
VITE_MCP_URL=
